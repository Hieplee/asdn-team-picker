rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOrg() {
      return request.auth != null
        && request.auth.uid in ['57BKTGPZoDaIc2wChRWut3NBf6E3', 'kEkdLPY3kLWPCVBJG8112W1yDlB3', 'ig2pUINnEgZX4HzXbCRyjtvKQ2E3', 'ZCJPrmNKeXQBx6O56iUcwKoLupz2', '5QtTq81TTrbt0TPA5BujGMeBQ6N2', 'kxqeEMLDssf6A2rdPJ1tS0XrpX82'];
    }
    function signedIn() { return request.auth != null; }
    function validTeam(t) { return t in ['0', '1', '2', '3', '4', '5']; }
    // Người chơi thuộc đội teamId khi đã có memberOf/{uid} trỏ về đội đó.
    function inTeam(teamId) {
      return signedIn()
        && exists(/databases/$(database)/documents/match/current/memberOf/$(request.auth.uid))
        && get(/databases/$(database)/documents/match/current/memberOf/$(request.auth.uid)).data.teamId == teamId;
    }
    function num(v, lo, hi) { return (v is int || v is float) && v >= lo && v <= hi; }

    // ===== Bản đồ trực tiếp: dữ liệu chỉ tồn tại trong lúc trận diễn ra, xóa khi kết thúc trận =====
    // Bật/tắt chia sẻ vị trí toàn trận.
    match /match/current/config/{doc} {
      allow read: if signedIn();
      allow create, update: if isOrg() && (
        (doc == 'live' && request.resource.data.keys().hasOnly(['live', 'at'])
          && request.resource.data.live is bool)
        || (doc == 'map' && request.resource.data.keys().hasOnly(['map', 'at'])
          && request.resource.data.map in ['nui', 'pho']));
      allow delete: if isOrg();
    }
    // Mã vào đội (6 ký tự, ký tự đầu là số đội). Chỉ organizer đọc/ghi; rules đọc bằng get().
    match /match/current/teamKeys/{teamId} {
      allow read, delete: if isOrg();
      allow create, update: if isOrg() && validTeam(teamId)
        && request.resource.data.keys().hasOnly(['code', 'at'])
        && request.resource.data.code is string
        && request.resource.data.code.size() == 6;
    }
    // Đội trưởng của từng đội (memberId).
    match /match/current/teamMeta/{teamId} {
      allow read: if signedIn();
      allow create, update: if isOrg() && validTeam(teamId)
        && request.resource.data.keys().hasOnly(['captain'])
        && request.resource.data.captain is string
        && request.resource.data.captain.size() <= 60;
      allow delete: if isOrg();
    }
    // memberOf/{uid} và members/{memberId} luôn được tạo cùng một batch, kiểm tra chéo bằng getAfter().
    // memberOf giữ mã đội nên chỉ chính chủ và organizer đọc được.
    match /match/current/memberOf/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isOrg());
      allow list: if isOrg();
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['memberId', 'teamId', 'code'])
        && request.resource.data.memberId is string
        && request.resource.data.memberId.size() <= 60
        && request.resource.data.teamId is string
        && validTeam(request.resource.data.teamId)
        && request.resource.data.code is string
        && int(request.resource.data.teamId) in get(/databases/$(database)/documents/public/current).data.get('lockedTeams', [])
        && get(/databases/$(database)/documents/public/current).data.assignments[request.resource.data.memberId] == int(request.resource.data.teamId)
        && get(/databases/$(database)/documents/match/current/teamKeys/$(request.resource.data.teamId)).data.code == request.resource.data.code
        && !exists(/databases/$(database)/documents/match/current/members/$(request.resource.data.memberId))
        && getAfter(/databases/$(database)/documents/match/current/members/$(request.resource.data.memberId)).data.uid == uid
        && getAfter(/databases/$(database)/documents/match/current/members/$(request.resource.data.memberId)).data.teamId == request.resource.data.teamId;
      allow update: if false;
      allow delete: if isOrg();
    }
    // Ai vào trước giữ tên. Ai đăng nhập cũng đọc được để biết tên nào đã có người nhận.
    match /match/current/members/{memberId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'teamId'])
        && request.resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/match/current/memberOf/$(request.auth.uid)).data.memberId == memberId
        && getAfter(/databases/$(database)/documents/match/current/memberOf/$(request.auth.uid)).data.teamId == request.resource.data.teamId;
      allow update: if false;
      allow delete: if isOrg();
    }
    // Vị trí của từng người, ghi đè một doc mỗi người, không lưu lịch sử. Chỉ đội mình đọc được.
    match /match/current/teams/{teamId}/positions/{uid} {
      allow read: if inTeam(teamId);
      allow create, update: if signedIn() && request.auth.uid == uid && inTeam(teamId)
        && request.resource.data.keys().hasOnly(['lat', 'lng', 'acc', 'heading', 'ts'])
        && num(request.resource.data.lat, -90, 90)
        && num(request.resource.data.lng, -180, 180)
        && num(request.resource.data.acc, 0, 100000)
        && (request.resource.data.heading == null || num(request.resource.data.heading, 0, 360))
        && request.resource.data.ts == request.time;
      allow delete: if (signedIn() && request.auth.uid == uid) || isOrg();
    }

    // Lệnh trên bản đồ. Id cố định để rules giới hạn số lượng và để organizer dọn được khi hết trận mà không cần đọc:
    // mục tiêu t_{uid}_{0..2} (ai trong đội cũng đặt được), mũi tên a_{0..9} và vùng z_{0..9} (chỉ đội trưởng).
    // pts là mảng phẳng [lat, lng, lat, lng, ...] vì Firestore không cho mảng lồng nhau.
    function myMid() {
      return get(/databases/$(database)/documents/match/current/memberOf/$(request.auth.uid)).data.memberId;
    }
    function isCaptain(teamId) {
      return exists(/databases/$(database)/documents/match/current/teamMeta/$(teamId))
        && get(/databases/$(database)/documents/match/current/teamMeta/$(teamId)).data.captain == myMid();
    }
    match /match/current/teams/{teamId}/orders/{oid} {
      allow read: if inTeam(teamId);
      allow create, update: if signedIn() && inTeam(teamId)
        && request.resource.data.keys().hasOnly(['type', 'pts', 'by', 'mid', 'ts'])
        && request.resource.data.by == request.auth.uid
        && request.resource.data.mid == myMid()
        && request.resource.data.ts == request.time
        && request.resource.data.pts is list
        && request.resource.data.pts.size() % 2 == 0
        && (
          (request.resource.data.type == 'target' && request.resource.data.pts.size() == 2
            && oid.matches('t_' + request.auth.uid + '_[0-2]'))
          || (request.resource.data.type == 'attack' && request.resource.data.pts.size() == 2
            && oid.matches('atk_[0-4]') && isCaptain(teamId))
          || (request.resource.data.type == 'defend' && request.resource.data.pts.size() == 2
            && oid.matches('def_[0-4]') && isCaptain(teamId))
          || (request.resource.data.type == 'arrow' && request.resource.data.pts.size() >= 4 && request.resource.data.pts.size() <= 40
            && oid.matches('a_[0-9]') && isCaptain(teamId))
          || (request.resource.data.type == 'zone' && request.resource.data.pts.size() >= 6 && request.resource.data.pts.size() <= 40
            && oid.matches('z_[0-9]') && isCaptain(teamId)));
      allow delete: if isOrg()
        || (signedIn() && resource.data.by == request.auth.uid)
        || (inTeam(teamId) && isCaptain(teamId));
    }

    // Báo chết: một doc mỗi người (id = memberId), ghi đè khi chết lại, xóa = hồi sinh.
    // Người chơi chỉ báo cho chính mình; đội trưởng báo hộ được người cùng đội (theo phân đội, kể cả người chưa vào đội). Organizer xóa được để reset ván.
    match /match/current/teams/{teamId}/deaths/{mid} {
      allow read: if inTeam(teamId);
      allow create, update: if signedIn() && inTeam(teamId)
        && request.resource.data.keys().hasOnly(['mid', 'lat', 'lng', 'by', 'ts'])
        && request.resource.data.mid == mid
        && request.resource.data.by == request.auth.uid
        && request.resource.data.ts == request.time
        && num(request.resource.data.lat, -90, 90)
        && num(request.resource.data.lng, -180, 180)
        && (mid == myMid()
          || (isCaptain(teamId)
            && get(/databases/$(database)/documents/public/current).data.assignments[mid] == int(teamId)));
      allow delete: if isOrg()
        || (inTeam(teamId) && (mid == myMid() || isCaptain(teamId)));
    }

    match /public/current {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.uid in ['57BKTGPZoDaIc2wChRWut3NBf6E3', 'kEkdLPY3kLWPCVBJG8112W1yDlB3', 'ig2pUINnEgZX4HzXbCRyjtvKQ2E3', 'ZCJPrmNKeXQBx6O56iUcwKoLupz2', '5QtTq81TTrbt0TPA5BujGMeBQ6N2', 'kxqeEMLDssf6A2rdPJ1tS0XrpX82']
        && request.resource.data.keys().hasOnly(['selected', 'guests', 'teamCount', 'mode', 'assignments', 'splitMode', 'lockedPlayers', 'lockedTeams'])
        && request.resource.data.selected is list
        && request.resource.data.selected.size() <= 100
        && request.resource.data.guests is list
        && request.resource.data.guests.size() <= 100
        && request.resource.data.teamCount is int
        && request.resource.data.teamCount >= 2
        && request.resource.data.teamCount <= 6
        && request.resource.data.mode in ['cqb', 'outdoor']
        && request.resource.data.assignments is map
        && (!('lockedPlayers' in request.resource.data) || (request.resource.data.lockedPlayers is list && request.resource.data.lockedPlayers.size() <= 100))
        && (!('lockedTeams' in request.resource.data) || (request.resource.data.lockedTeams is list && request.resource.data.lockedTeams.size() <= 6))
        && (!('splitMode' in request.resource.data) || request.resource.data.splitMode in ['balanced', 'random']);
    }
    match /public/attributes {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.uid in ['57BKTGPZoDaIc2wChRWut3NBf6E3', 'kEkdLPY3kLWPCVBJG8112W1yDlB3', 'ig2pUINnEgZX4HzXbCRyjtvKQ2E3', 'ZCJPrmNKeXQBx6O56iUcwKoLupz2', '5QtTq81TTrbt0TPA5BujGMeBQ6N2', 'kxqeEMLDssf6A2rdPJ1tS0XrpX82']
        && request.resource.data.keys().hasOnly(['ratings', 'styles', 'stats']);
    }
    // Append-only edit history. Only the system admin (hiepbrse@gmail.com) can read it.
    match /auditLog/{entry} {
      allow read: if request.auth != null && request.auth.uid == '57BKTGPZoDaIc2wChRWut3NBf6E3';
      allow create: if request.auth != null
        && request.auth.uid in ['57BKTGPZoDaIc2wChRWut3NBf6E3', 'kEkdLPY3kLWPCVBJG8112W1yDlB3', 'ig2pUINnEgZX4HzXbCRyjtvKQ2E3', 'ZCJPrmNKeXQBx6O56iUcwKoLupz2', '5QtTq81TTrbt0TPA5BujGMeBQ6N2', 'kxqeEMLDssf6A2rdPJ1tS0XrpX82']
        && request.resource.data.keys().hasOnly(['uid', 'email', 'doc', 'changes', 'at'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.doc in ['current', 'attributes']
        && request.resource.data.changes is list
        && request.resource.data.changes.size() <= 300
        && request.resource.data.at == request.time;
      allow update, delete: if false;
    }
  }
}
